# ─── LLM API Keys (set at least one) ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ─── Ollama (local LLM – optional) ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Auth (MUST match the JWT_SECRET in frontend .env.local) ──────────────────
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# ─── Encryption key for stored DB credentials (32 chars) ──────────────────────
CONNECTIONS_SECRET=change_me_to_32_char_encryption_key

# ─── CORS (comma-separated list of allowed frontend origins) ──────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Rate limits ──────────────────────────────────────────────────────────────
ASK_RATE_LIMIT=30/minute
SUGGEST_RATE_LIMIT=60/minute
DASHBOARD_RATE_LIMIT=10/minute

# ─── Stripe Billing ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_price_id

# ─── App URL (used for Stripe redirect URLs) ──────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Storage paths ────────────────────────────────────────────────────────────
# USER_DATA_DB=user_data.db      # SQLite file for history/saved-queries/projects/teams

# ─── Optional: point to a PostgreSQL app database instead of flat files ───────
# DATABASE_URL=postgresql://user:password@localhost:5432/insightsql
