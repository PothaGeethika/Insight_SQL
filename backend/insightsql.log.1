WITH sales AS (
    SELECT CS_BILL_CUSTOMER_SK AS customer_sk, CS_NET_PAID_INC_TAX AS spent
    FROM CATALOG_SALES
    UNION ALL
    SELECT SS_CUSTOMER_SK, SS_NET_PAID_INC_TAX
    FROM STORE_SALES
    UNION ALL
    SELECT WS_BILL_CUSTOMER_SK, WS_NET_PAID_INC_TAX
    FROM WEB_SALES
),
customer_spending AS (
    SELECT customer_sk, SUM(spent) AS total_spent
    FROM sales
    GROUP BY customer_sk
)
SELECT c.C_CUSTOMER_SK, c.C_CUSTOMER_ID, c.C_FIRST_NAME, c.C_LAST_NAME, c.C_EMAIL_ADDRESS, cs.total_spent
FROM customer_spending cs
JOIN CUSTOMER c ON cs.customer_sk = c.C_CUSTOMER_SK
ORDER BY cs.total_spent DESC
LIMIT 5;
