    SELECT WS_BILL_CUSTOMER_SK, WS_NET_PAID_INC_TAX
    FROM WEB_SALES
) sales
JOIN CUSTOMER c ON sales.customer_sk = c.C_CUSTOMER_SK
GROUP BY c.C_NAME
ORDER BY total_spent DESC
LIMIT 5
