SELECT 
    c.C_NAME,
    SUM(sales.total_spent) AS total_spent
FROM (
    SELECT CS_BILL_CUSTOMER_SK AS customer_sk, CS_NET_PAID_INC_TAX AS total_spent
    FROM CATALOG_SALES
